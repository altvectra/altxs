# Lockstep env for incremental AC encode/decode — both sides must match.
# Production path: run_decode_row_dev + decode_symbol.
# Leave XSA_AC_DECODE_UNROLL unset. Do not set XSA_AC_NO_GRAPH=1.
# XSA_AC_ENC_ATTN_GROUP=4 diverges (use 1).
PROFILE=large
SEED=1337
XSA_TTT_DEVICE=cuda
XSA_RETRAIN_MODE=replenish
XSA_BLOCK_SIZE=16384
XSA_RETRAIN_EVERY=16384
XSA_RETRAIN_STEPS=1
XSA_RETRAIN_LR=3e-4
XSA_REPLENISH_RAMP=64
XSA_REPLENISH_ANNEAL=exp
XSA_REPLENISH_LR_HALF_MB=90
XSA_REPLENISH_LR_MIN=4e-5
XSA_REPLENISH_TOTAL_BYTES=180086975
XSA_REPLENISH_WARMUP_STEPS=16
XSA_REPLENISH_ACCUM=1
XSA_REPLENISH_REPLAY_LR_SCALE=1.0
XSA_REPLENISH_REPLAY_RECENT_MB=1.0
XSA_REPLENISH_ANCHOR=
XSA_REPLENISH_ANCHOR_RATE=0.05
XSA_REPLENISH_XM_K=3
XSA_REPLENISH_XM_PROBE_CHUNKS=1
XSA_REPLENISH_XM_4X_UNTIL_MB=100
XSA_TTT_BETA1=0.9
XSA_TTT_BETA2=0.999
XSA_TTT_WEIGHT_DECAY=0
COMPRESSION_DETERMINISTIC=strict
CUBLAS_WORKSPACE_CONFIG=:4096:8
AC_N_SYMBOLS=576278322
XSA_BF16=1
XSA_GRAD_CKPT=1
XSA_ROPE_YARN=1
XSA_AC_INCREMENTAL=1
XSA_ATTN_CHUNK=2048
XSA_ATTN_TRITON=1
XSA_AC_WINDOW=64
XSA_AC_DECODE_ROW=1
XSA_AC_DECODE_K=64
XSA_AC_ENCODE_ROW=0
XSA_AC_MEGA_ENCODE=1
XSA_AC_ENC_ATTN_GROUP=1
XSA_AC_ENCODE_FFN=rows
XSA_AC_ATTN_SPLITS=8
XSA_AC_ATTN_BLOCK=256
XSA_AC_GQA_DEDUP=1
XSA_AC_STAGE_FUSION=1
XSA_AC_DRAFT=0
XSA_AC_DRAFT_POOL=128
XSA_AC_DRAFT_WINDOW=128
XSA_AC_FUSED=1
XSA_AC_PERSISTENT=1
XSA_AC_MEGA=1
XSA_AC_GPU_AC=1
